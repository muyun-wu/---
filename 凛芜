<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>个人主页</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #1a1a1a;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    color: #fff;
  }

  /* 手机外壳 */
  .phone {
    width: 100%;
    max-width: 420px;
    height: 100vh;
    max-height: 900px;
    background: #2c2c2c;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* 如果要在电脑上模拟手机边框，可以加圆角和边框 */
    /* border-radius: 40px; border: 8px solid #000; */
  }

  /* 背景图区域 */
  .bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=800'); /* 替换成你的图 */
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) brightness(0.6);
    z-index: 0;
  }

  /* 内容层 */
  .content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px;
    padding-bottom: 100px; /* 给底部导航留空间 */
    overflow-y: auto;
  }

  /* 顶部头像卡片 */
  .profile-card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 30px 20px;
    text-align: center;
    margin-top: 40px;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255,255,255,0.3);
    margin-bottom: 15px;
  }

  .name {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .handle {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 15px;
  }

  .bio {
    font-size: 15px;
    color: rgba(255,255,255,0.8);
    margin-bottom: 10px;
  }

  .location {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
  }

  /* 页面切换 */
  .page {
    display: none;
    flex: 1;
  }

  .page.active {
    display: block;
  }

  /* 底部导航 */
  .nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: rgba(30,30,30,0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.1);
    z-index: 10;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    cursor: pointer;
    padding: 8px 16px;
    border-radius: 12px;
    transition: all 0.3s;
  }

  .nav-item.active {
    color: #fff;
  }

  .nav-item .icon {
    font-size: 22px;
  }

  /* 弹窗 */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }

  .modal-overlay.show {
    opacity: 1;
    pointer-events: auto;
  }

  .modal {
    background: rgba(40,40,40,0.95);
    backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 30px 25px;
    width: 80%;
    max-width: 300px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.1);
    transform: scale(0.9);
    transition: transform 0.3s;
  }

  .modal-overlay.show .modal {
    transform: scale(1);
  }

  .modal p {
    font-size: 18px;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .modal button {
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    padding: 10px 30px;
    border-radius: 20px;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.3s;
  }

  .modal button:hover {
    background: rgba(255,255,255,0.25);
  }

  /* 占位内容 */
  .placeholder {
    text-align: center;
    padding: 40px 20px;
    color: rgba(255,255,255,0.4);
    font-size: 14px;
  }
</style>
</head>
<body>

<div class="phone">
  <div class="bg"></div>

  <div class="content">
    <!-- 页面1：主页 -->
    <div class="page active" id="page-home">
      <div class="profile-card">
        < img class="avatar" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200" alt="头像">
        <div class="name">江也</div>
        <div class="handle">@ayeshun_shun</div>
        <div class="bio">等到眼泪魔力失效那天离开我</div>
        <div class="location">📍 中国</div>
      </div>
    </div>

    <!-- 页面2：相册/其他 -->
    <div class="page" id="page-gallery">
      <div class="placeholder">
        <p>📷 这里可以放照片墙</p >
        <p>用 grid 布局排列图片</p >
      </div>
    </div>

    <!-- 页面3：留言/关于 -->
    <div class="page" id="page-about">
      <div class="placeholder">
        <p>💬 这里可以放留言板</p >
        <p>或者关于我的介绍</p >
      </div>
    </div>
  </div>

  <!-- 底部导航 -->
  <div class="nav">
    <div class="nav-item active" data-page="page-home">
      <span class="icon">🏠</span>
      <span>主页</span>
    </div>
    <div class="nav-item" data-page="page-gallery">
      <span class="icon">🖼️</span>
      <span>相册</span>
    </div>
    <div class="nav-item" data-page="page-about">
      <span class="icon">💬</span>
      <span>关于</span>
    </div>
  </div>
</div>

<!-- 弹窗 -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <p>你还在哭吗？</p >
    <button onclick="closeModal()">嗯</button>
  </div>
</div>

<script>
  // 页面切换
  const navItems = document.querySelectorAll('.nav-item');
  const pages = document.querySelectorAll('.page');

  navItems.forEach(item => {
    item.addEventListener('click', () => {
      // 移除所有 active
      navItems.forEach(i => i.classList.remove('active'));
      pages.forEach(p => p.classList.remove('active'));

      // 激活当前
      item.classList.add('active');
      const pageId = item.dataset.page;
      document.getElementById(pageId).classList.add('active');
    });
  });

  // 弹窗
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.getElementById('modal').classList.add('show');
    }, 500); // 0.5秒后弹出
  });

  function closeModal() {
    document.getElementById('modal').classList.remove('show');
  }

  // 点击遮罩关闭
  document.getElementById('modal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      closeModal();
    }
  });
</script>

</body>
</html>
